# Internal Developer Portal — local development environment.
# Copy to .env and adjust. NEVER commit a filled-in .env file.
#
# In production every one of these is injected by the deployment pipeline
# from repository secrets; nothing below is used on a deployed host.

# --- Database -------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/idp
DB_USERNAME=idp
DB_PASSWORD=localdevpassword

# --- Authentication -------------------------------------------------------
# HS256 requires at least 32 characters. The application refuses to start
# with anything shorter.
JWT_SECRET=local-development-secret-at-least-32-characters-long

# --- Seeded administrator -------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=localadminpassword
