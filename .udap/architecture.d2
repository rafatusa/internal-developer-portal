# udap:meta cloud=aws region=us-east-1 target=ec2

user: Developer { shape: rectangle; udap-type: generic.user }
ghcr: GitHub Container Registry { shape: rectangle; udap-type: generic.cdn }
vpc: AWS VPC us-east-1 {
  eip: Elastic IP { shape: rectangle; udap-type: aws.ec2 }
  sg: Security Group { shape: rectangle; udap-type: aws.ec2 }
  iam: IAM Instance Role { shape: rectangle; udap-type: aws.ec2 }
  ec2: EC2 t3.medium { shape: rectangle; udap-type: aws.ec2 }
  nginx: Nginx Proxy { shape: rectangle; udap-type: generic.app }
  app: Spring Boot API { shape: rectangle; udap-type: generic.app }
  db: PostgreSQL Container { shape: rectangle; udap-type: generic.db }
}

user -> vpc.eip: HTTPS :443
vpc.eip -> vpc.nginx: routes to
vpc.nginx -> vpc.app: proxy :8080
vpc.app -> vpc.db: :5432
ghcr -> vpc.ec2: docker pull
vpc.iam -> vpc.ec2: instance profile
vpc.sg -> vpc.ec2: 80/443/22
