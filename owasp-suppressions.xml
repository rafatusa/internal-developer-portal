<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      Suppressions must be justified, scoped to a single dependency, and
      reviewed. An empty file is the correct default: nothing is suppressed
      until a specific false positive is demonstrated.

      Template for a real entry:

      <suppress>
        <notes>False positive: CVE applies to the server component, we only
               ship the client library. Reviewed YYYY-MM-DD.</notes>
        <packageUrl regex="true">^pkg:maven/group/artifact@.*$</packageUrl>
        <cve>CVE-0000-00000</cve>
      </suppress>
    -->
</suppressions>
