<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter — Internal Developer Portal
  Excludes: generated code, known-safe security patterns, Lombok artefacts.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!-- Exclude test classes -->
  <Match>
    <Class name="~.*Test.*"/>
  </Match>
  <Match>
    <Class name="~.*IT$"/>
  </Match>

  <!-- Exclude Lombok-generated code (Lombok generates null checks that SpotBugs flags) -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    <Class name="~.*\.dto\..*"/>
  </Match>

  <!-- JWT secret stored as String — acceptable in app scope -->
  <Match>
    <Bug pattern="HARD_CODE_PASSWORD"/>
    <Class name="com.enterprise.idp.security.JwtTokenProvider"/>
  </Match>

  <!-- Spring Security: exposing actuator endpoints is intentional -->
  <Match>
    <Bug pattern="SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING"/>
    <Class name="com.enterprise.idp.config.SecurityConfig"/>
  </Match>

  <!-- Exclude main application entry point -->
  <Match>
    <Class name="com.enterprise.idp.InternalDeveloperPortalApplication"/>
  </Match>

  <!-- MapStruct generated mappers -->
  <Match>
    <Class name="~.*MapperImpl"/>
  </Match>

</FindBugsFilter>
